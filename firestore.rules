rules_version = '2';

// Firestore security rules  (v2026-10-25 : 3 admins / email verification required)
// Firebase console > Firestore Database > Rules : delete everything, paste this, then Publish.
// - Anyone : read public content (bulletins, shokudo, album) / create feedback only
// - Admins : write public content, read & manage feedback

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = email in this list AND email verified
    // (verification is required, so nobody else can register the same address and become admin)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['donkah16@gmail.com', 'knockj.pla@gmail.com', 'shinsei.fukuoka.media@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function validTarget(t) {
      return t == null
        || (t is map
            && t.keys().hasOnly(['selector', 'text'])
            && isStr(t.selector, 500)
            && isStr(t.text, 100));
    }

    // ---------- Public content (managed in /admin/) ----------
    match /bulletins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bulletinPages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shokudo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /album/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /albumFull/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sermons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /morning/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /missionNews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /people/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Feedback ----------
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['page', 'pageTitle', 'target', 'message', 'name', 'device', 'status', 'createdAt'])
        && isStr(request.resource.data.page, 200)
        && isStr(request.resource.data.pageTitle, 100)
        && validTarget(request.resource.data.target)
        && isStr(request.resource.data.message, 2000)
        && request.resource.data.message.size() > 0
        && isStr(request.resource.data.name, 50)
        && request.resource.data.device in ['pc', 'sp']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'memo'])
        && request.resource.data.status in ['new', 'hold', 'done']
        && isStr(request.resource.data.get('memo', ''), 500);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
